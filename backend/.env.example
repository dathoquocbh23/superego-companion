# Sao chép file này thành `.env` rồi điền giá trị thật.

# --- LLM ---
LLM_PROVIDER=gemini            # "gemini" (Google AI Studio) | "anthropic"
LLM_OFFLINE=false              # true → không gọi API, trả câu tĩnh (test pipeline/safety)

# Gemini — lấy key ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — chỉ cần khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Hạ tầng ---
REDIS_URL=                     # để trống → overlay sống trong RAM (đủ cho demo)
OVERLAY_TTL_SECONDS=86400
LOG_PATH=./data/turns.jsonl
CORS_ORIGINS=http://localhost:3000

# --- Ngưỡng (docx/03 §3, docx/11 phần D) ---
CONFIDENCE_THRESHOLD=0.70
EXTRACT_CONFIDENCE_CAP=0.60
SELF_REPORT_CONFIDENCE_CAP=0.75
MIN_NODES_FOR_REFLECT=3
MAX_RESPONSE_SENTENCES=5
CRISIS_TIER3_MAX_CHARS=600

# --- Bộ nhớ dài hạn (tuỳ chọn, xem docx/12) ---
# MEMORY_ENABLED=false => toàn bộ tính năng im lặng tắt, app chạy y như cũ.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEMORY_ENABLED=false
MEMORY_HALF_LIFE_DAYS=30
MEMORY_MAX_SEED_NODES=8
MEMORY_SEED_CONFIDENCE_CAP=0.50
# Loại node được phép nhắc lại NGUYÊN VĂN từ phiên trước (docx/12 §5.1).
# trigger+impact = sự việc. Thêm manifestation/affect = nhắc lại lời tự phán
# xét của học sinh — đọc §5.1 trước khi đổi.
MEMORY_RECALL_NODE_TYPES=trigger,impact

# --- Lưu hội thoại nguyên văn (GĐ6, 07/09/2026) ---
# Ghi conversations + messages vào Supabase để phục vụ nghiên cứu.
# Dùng chung SUPABASE_* ở trên nhưng là công tắc RIÊNG với MEMORY_ENABLED:
# tắt bộ nhớ mà vẫn lưu transcript (hoặc ngược lại) là hai chuyện khác nhau.
# Mặc định BẬT; thiếu SUPABASE_* thì tự thành no-op.
TRANSCRIPT_ENABLED=true

# --- Overlay backend (GĐ6d, 07/09/2026) ---
# "redis" (mặc định) cần REDIS_URL trỏ dịch vụ Redis thật. Free tier Render
# không có Redis cục bộ — không cấu hình gì thì overlay ÂM THẦM rơi về RAM
# trong tiến trình và mất mọi phiên khi container khởi động lại.
# "supabase" dùng luôn SUPABASE_* đã có, không cần đăng ký dịch vụ ngoài —
# khuyến nghị khi deploy Render free tier. Nhớ chạy db/migrations/006 trước.
OVERLAY_BACKEND=redis
